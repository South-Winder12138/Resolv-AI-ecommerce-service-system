OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
OPENAI_BASE_URL=
# DATABASE_URL defaults to data/resolv.db under the project root.
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=resolv_knowledge_v1
# RAG embedding correctness baseline; independent of OpenAI and Milvus.
BGE_M3_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_USE_FP16=false
EMBEDDING_QUERY_MAX_LENGTH=512
EMBEDDING_PASSAGE_MAX_LENGTH=512
# Knowledge MySQL is separate from the existing SQLite DATABASE_URL.
MYSQL_DATABASE=resolv_knowledge
MYSQL_USER=resolv_knowledge
# Set local passwords; compose fails early if either is missing/empty.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Replace <url-encoded-password> with MYSQL_PASSWORD, percent-encoded for a URL.
KNOWLEDGE_DATABASE_URL=mysql+pymysql://resolv_knowledge:<url-encoded-password>@127.0.0.1:3307/resolv_knowledge?charset=utf8mb4
# Enable fixed retrieval before HTTP chat; use the revision/profile used for indexing.
KNOWLEDGE_CHAT_ENABLED=false
KNOWLEDGE_CHAT_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
KNOWLEDGE_CHAT_COLLECTION=resolv_knowledge_v2
KNOWLEDGE_CHAT_TOP_K=5
KNOWLEDGE_CHAT_PASSAGE_MAX_LENGTH=512
KNOWLEDGE_CHAT_QUERY_MAX_LENGTH=512
# Separate conversation business records and graph checkpoints; explicit setup only.
CONVERSATION_DATABASE_URL=mysql+pymysql://resolv_knowledge:<url-encoded-password>@127.0.0.1:3307/resolv_conversations?charset=utf8mb4
# Explicit smoke must point to a separate resolv_conversations_smoke_SUFFIX database.
# CONVERSATION_SMOKE_DATABASE_URL=...
# Set these only from the actual provider's configured model window/tokenizer.
CONTEXT_MODEL_CONTEXT_WINDOW_TOKENS=
CONTEXT_TOKENIZER_PROFILE=
CONTEXT_APP_MAX_INPUT_TOKENS=12000
CONTEXT_HISTORY_SOFT_BUDGET_TOKENS=6000
CONTEXT_SUMMARY_TRIGGER_RATIO=0.8
CONTEXT_RECENT_HISTORY_TARGET_TOKENS=2000
CONTEXT_SUMMARY_MAX_TOKENS=800
CONTEXT_KNOWLEDGE_CONTEXT_MAX_TOKENS=3000
CONTEXT_RESERVED_OUTPUT_TOKENS=2000
CONTEXT_SAFETY_MARGIN_TOKENS=1000
# Independent summarizer; explicitly fill even if using the same provider/model.
SUMMARY_MODEL_NAME=
SUMMARY_API_KEY=
SUMMARY_BASE_URL=
SUMMARY_MODEL_CONTEXT_WINDOW_TOKENS=
SUMMARY_RESERVED_OUTPUT_TOKENS=2000
SUMMARY_INPUT_MAX_TOKENS=12000
SUMMARY_MAX_TOKENS=800
SUMMARY_TIMEOUT_SECONDS=60
# Independent understanding endpoint; chat entrypoints remain as configured.
UNDERSTANDING_ENABLED=false
UNDERSTANDING_TIMEOUT_SECONDS=60
# Independent calibrated default; does not change the chat CONTEXT budget.
UNDERSTANDING_PROVIDER_INPUT_OVERHEAD_TOKENS=6500
UNDERSTANDING_REASONING_EFFORT=low
